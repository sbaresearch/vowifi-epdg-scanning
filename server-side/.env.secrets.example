# ============================================================
# Global python log level
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# Postgres configuration
# ============================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=epdg

# generate username.
POSTGRES_USER=

# generate password.
POSTGRES_PASSWORD=


# ============================================================
# API configuration
# ============================================================

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Generate a secure API key.
# Set it here AND in frontend/static/map.js table.js takeout.js and collisions.js
# Also set it in tools/fingerprint/enrich.py if you use it.
# It's possible to leave it empty.
API_KEY=

ENABLE_DOCS=true

DEFAULT_LIMIT=130                        # Default number of items to return in api response.
MAX_LIMIT=600                            # Maximum number of items to return in api response.

ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120       # How many requests a client can make per minute.
RATE_LIMIT_TIMEOUT_SECONDS=60            # How long a client is limited.


# ============================================================
# mcc-mnc.com enrichment API
# ============================================================

# Register at mcc-mnc.com, anonymous access is retired.
MCC_MNC_API_TOKEN=


# ============================================================
# zulip configuration (populate with info on demand)
# ============================================================

ZULIP_SERVER_URL=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=


# ============================================================
# VPN vantage points
# ============================================================

# the host's own scan, named after where it sits (appears in exports and the map).
# put the location of the machine that runs the pipeline here, e.g. "austria" or
# "germany". This is used to label the vantage point in the map and exports.
LOCAL_VANTAGE_LABEL=austria
LOCAL_VANTAGE_COUNTRY=Austria

# VPN vantage points: enable/disable
VANTAGE_ENABLED=true

# VPN operators: infrastructure/vantage_points.json
VANTAGE_POINTS_FILE=/config/vantage_points.json

# how frequent the container should log progress of the scans (in seconds). 900 = 15 min.
VANTAGE_PROGRESS_SECONDS=900

# Scan modes, all running continuously:
#   full         zdns discovery in the tunnel, all testcases, via the VPN exit
#   full_warp    targets from epdg_server, all testcases, via Cloudflare WARP
#   dh2048_warp  targets from epdg_server, DH2048 only, via WARP
#
# Tunnels per mode (total 7 here); VPN device limits still apply (README "Parallelism").
VANTAGE_FULL_PARALLEL=2
VANTAGE_FULL_WARP_PARALLEL=3
VANTAGE_DH2048_WARP_PARALLEL=2

# per-scan watchdogs, not schedules.
VANTAGE_FULL_TIMEOUT_SECONDS=108000      # 30h: discovery + ~13h pass
VANTAGE_FULL_WARP_TIMEOUT_SECONDS=72000  # 20h
VANTAGE_DH2048_TIMEOUT_SECONDS=7200      # 2h (a sweep takes ~35 min)

# Cloudflare WARP hop: a second gluetun behind the VPN; anycast endpoint.
WARP_HOP_ATTEMPTS=2                      # tunnels to try (2 = one retry per tunnel)


# ============================================================
# VPN credentials (names as in scanywhere's credentials.json); a provider is used
# once all its variables are set. How to get them:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# ============================================================

# nordvpn: max 6 devices
NORD_OPENVPN_USER=
NORD_OPENVPN_PASSWORD=
NORD_WIREGUARD_PRIVATE_KEY=

# mullvad: max 5 devices, wireguard only
MULLVAD_WIREGUARD_PRIVATE_KEY=
MULLVAD_WIREGUARD_ADDRESSES=

# surfshark: unlimited devices
SURFSHARK_OPENVPN_USER=
SURFSHARK_OPENVPN_PASSWORD=
SURFSHARK_WIREGUARD_PRIVATE_KEY=
SURFSHARK_WIREGUARD_ADDRESSES=

# protonvpn: max 10 devices
PROTON_OPENVPN_USER=
PROTON_OPENVPN_PASSWORD=

# private internet access: unlimited devices
PIA_OPENVPN_USER=
PIA_OPENVPN_PASSWORD=

# hidemyass: max 5 devices
HMA_OPENVPN_USER=
HMA_OPENVPN_PASSWORD=

# cyberghost: max 7 devices
CYBERGHOST_OPENVPN_USER=
CYBERGHOST_OPENVPN_PASSWORD=
CYBERGHOST_OPENVPN_KEY=
CYBERGHOST_OPENVPN_CERT=

# ivpn: max 7 devices
IVPN_OPENVPN_USER=
IVPN_WIREGUARD_PRIVATE_KEY=
IVPN_WIREGUARD_ADDRESSES=
